{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=taskmanager_db;Username=taskmanager;Password=taskmanager_password",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "TaskManagerSecretKey123456789012345678901234567890",
    "Issuer": "TaskManager",
    "Audience": "TaskManagerUsers",
    "ExpiresInMinutes": 60
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429
  },
  "Partitioning": {
    "Enabled": true,
    "JobTimeUtc": "01:00:00",
    "CheckInterval": "00:05:00",
    "Tables": [
      { "Table": "tasks", "Interval": "Month", "PeriodsAhead": 3 },
      { "Table": "lab03.events", "Interval": "Day", "PeriodsAhead": 3, "RetentionPeriods": 30 }
    ]
  },
  "Alerts": {
    "Telegram": {
      "BotToken": "",
      "ChatId": ""
    }
  }
}
