# Copy to .env (it is in .gitignore) and fill in to receive partition alerts in Telegram.
# Without these values alerts are only written to the API log.
#   TELEGRAM_BOT_TOKEN - token from @BotFather
#   TELEGRAM_CHAT_ID   - chat that receives alerts: press /start in the bot, then open
#                        https://api.telegram.org/bot<token>/getUpdates and take message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
