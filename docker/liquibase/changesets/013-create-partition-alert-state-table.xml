<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        ЛР №3 (часть 11.4): последнее известное состояние проверки партиций по каждой таблице.
        Оповещение отправляется только при смене состояния (OK → CRITICAL, CRITICAL → OK)
        или при изменении списка недостающих партиций, а не при каждой проверке.
        Состояние хранится в БД, поэтому переживает перезапуск сервиса.
    -->
    <changeSet id="013-create-partition-alert-state-table" author="taskmanager">
        <createTable tableName="partition_alert_state">
            <column name="table_name" type="varchar(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="missing_partitions" type="text" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="notified_at" type="timestamp with time zone">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
